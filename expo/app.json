{
  "expo":{
    "name":"ISAI","slug":"isai-music-player","version":"2.0.0","orientation":"portrait",
    "scheme":"isai","userInterfaceStyle":"automatic","newArchEnabled":true,
    "plugins":[
      "expo-router",
      ["expo-audio",{"enableBackgroundPlayback":true,"enableBackgroundRecording":false,"recordAudioAndroid":false}],
      ["expo-media-library",{"granularPermissions":["audio"],"isAccessMediaLocationEnabled":false}]
    ],
    "android":{
      "package":"com.rishinnovations.isai",
      "permissions":["android.permission.FOREGROUND_SERVICE","android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"]
    },
    "experiments":{"typedRoutes":true}
  }
}
